model LabeledDatasetRow {
  id                 String          @id @default(cuid())
  rowKey             String          @unique
  trainingDatasetId  String
  dataset            TrainingDataset @relation(fields: [trainingDatasetId], references: [id], onDelete: Cascade)
  decisionId         String
  symbol             String
  decision           String
  featureSnapshot    Json
  labels             Json
  executionMetrics   Json?
  replayMetrics      Json?
  entryMetrics       Json?
  exitMetrics        Json?
  marketRegime       String?
  coinCategory       String?
  pnlPct             Float?
  holdingTimeMinutes Float?
  slippagePct        Float?
  feePct             Float?
  validationStatus   String          @default("VALID")
  rejectionReason    String?
  decisionTimestamp  DateTime
  createdAt          DateTime        @default(now())

  @@unique([trainingDatasetId, decisionId])
  @@index([symbol, decisionTimestamp])
  @@index([validationStatus])
}

model CoinProfile {
  id                    String   @id @default(cuid())
  profileKey            String   @unique
  symbol                String   @unique
  avgWinRate            Float    @default(0)
  avgProfitPct          Float    @default(0)
  avgLossPct            Float    @default(0)
  bestHoldingMinutes    Float?
  worstHoldingMinutes   Float?
  bestEntryHour         Int?
  worstEntryHour        Int?
  bestMarketRegime      String?
  worstMarketRegime     String?
  avgVolatility         Float?
  avgSpread             Float?
  preferredStrategy     String?
  historicalConfidence  Float?
  tradeCount            Int      @default(0)
  metadata              Json?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@index([avgWinRate, tradeCount])
}

model MarketMemory {
  id                String   @id @default(cuid())
  memoryKey         String   @unique
  regimeType        String
  similarityVector  Json?
  occurrenceCount   Int      @default(0)
  avgReturnPct      Float?
  winRate           Float?
  avgVolatility     Float?
  metadata          Json?
  recordedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([regimeType, recordedAt])
}

model TradeMemory {
  id                    String   @id @default(cuid())
  memoryKey             String   @unique
  tradeId               String?
  decisionId            String?
  symbol                String
  whyWin                String?
  whyLoss               String?
  couldEnterEarlier     Boolean  @default(false)
  couldExitLater        Boolean  @default(false)
  strategyCorrect       Boolean?
  regimeCorrect         Boolean?
  structuredExplanation Json?
  pnlPct                Float?
  holdingMinutes        Float?
  metadata              Json?
  recordedAt            DateTime @default(now())

  @@index([symbol, recordedAt])
  @@index([tradeId])
}

model LearningInsight {
  id         String   @id @default(cuid())
  insightKey String   @unique
  category   String
  title      String
  content    String
  severity   String   @default("INFO")
  symbol     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([category, createdAt])
  @@index([symbol, createdAt])
}

model ModelCandidate {
  id                String               @id @default(cuid())
  candidateKey      String               @unique
  modelId           String
  model             MLModel              @relation(fields: [modelId], references: [id], onDelete: Cascade)
  trainingDatasetId String?
  trainingDataset   TrainingDataset?     @relation(fields: [trainingDatasetId], references: [id], onDelete: SetNull)
  role              ModelCandidateRole   @default(EXPERIMENTAL)
  status            ModelCandidateStatus @default(PENDING)
  shadowTradeCount  Int                  @default(0)
  profitFactor      Float?
  expectancy        Float?
  maxDrawdown       Float?
  winRate           Float?
  sharpe            Float?
  sortino           Float?
  auc               Float?
  promotionBlockers String[]             @default([])
  meetsCriteria     Boolean              @default(false)
  metadata          Json?
  evaluatedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, role])
  @@index([modelId])
}

model LearningReport {
  id             String   @id @default(cuid())
  reportKey      String   @unique
  reportType     String
  reportDate     DateTime
  strengths      Json?
  weaknesses     Json?
  worstDecisions Json?
  bestDecisions  Json?
  topCoins       Json?
  worstCoins     Json?
  bestHours      Json?
  worstHours     Json?
  improvements   Json?
  summary        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([reportType, reportDate])
}

model LearningPlatformJobState {
  id              String                  @id @default(cuid())
  jobType         LearningPlatformJobType @unique
  lastProcessedAt DateTime?
  status          String                  @default("IDLE")
  metadata        Json?
  updatedAt       DateTime                @updatedAt
  createdAt       DateTime                @default(now())
}

enum ResearchExperimentStatus {
  DRAFT
  RUNNING
  TRAINING
  VALIDATING
  WALK_FORWARD
  SHADOW_SIM
  COMPLETED
  FAILED
  ARCHIVED
}

enum WalkForwardMode {
  ROLLING
  EXPANDING
  PURGED
  TIME_SERIES
}

enum CounterfactualScenario {
  ENTER_EARLIER
  ENTER_LATER
  EXIT_EARLIER
  EXIT_LATER
  ALT_STRATEGY
  IGNORE_TRADE
  DOUBLE_HOLD
  HALF_HOLD
}

enum ResearchRecommendationType {
  NEW_STRATEGY
  NEW_FEATURE
  NEW_THRESHOLD
  NEW_MODEL
}

enum FeatureResearchStatus {
  ACTIVE
  HIGH_VALUE
  LOW_VALUE
  REDUNDANT
  CORRELATED
}

model ResearchExperiment {
  id              String                   @id @default(cuid())
  experimentId    String                   @unique
  projectId       String?
  name            String
  strategyType    StrategyArchetype
  strategyVersion String
  featureVersion  String
  datasetVersion  String
  author          String                   @default("system")
  genomeId        String?
  hypothesis      String?
  status          ResearchExperimentStatus @default(DRAFT)
  config          Json?
  metadata        Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  results            ResearchResult[]
  counterfactuals    CounterfactualResult[]
  walkForwardResults WalkForwardResult[]
  featureResearch    FeatureResearch[]
  strategyResearch   StrategyResearch[]
  metrics            ExperimentMetrics[]
  recommendations    ResearchRecommendation[]

  @@index([status, createdAt])
  @@index([strategyType, createdAt])
  @@index([author, createdAt])
}

model ResearchResult {
  id           String             @id @default(cuid())
  experimentId String
  experiment   ResearchExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  runId        String?
  phase        String
  passed       Boolean            @default(false)
  metrics      Json?
  evidence     Json?
  verdict      String?
  createdAt    DateTime           @default(now())

  @@index([experimentId, phase])
  @@index([createdAt])
}

model CounterfactualResult {
  id                    String                 @id @default(cuid())
  experimentId          String?
  experiment            ResearchExperiment?    @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  tradeId               String?
  learningTradeId       String?
  decisionId            String?
  scenario              CounterfactualScenario
  baselineReturnPct     Float?
  alternativeReturnPct  Float?
  alternativeDrawdownPct Float?
  alternativeWinRate    Float?
  alternativeRR         Float?
  alternativeHoldSec    Int?
  metrics               Json?
  evidence              Json?
  createdAt             DateTime               @default(now())

  @@index([experimentId, scenario])
  @@index([learningTradeId])
  @@index([decisionId])
  @@index([createdAt])
}

model WalkForwardResult {
  id           String              @id @default(cuid())
  experimentId String?
  experiment   ResearchExperiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  runId        String?
  mode         WalkForwardMode
  foldIndex    Int
  trainStart   DateTime?
  trainEnd     DateTime?
  testStart    DateTime?
  testEnd      DateTime?
  trainMetrics Json?
  testMetrics  Json?
  passed       Boolean             @default(false)
  purgeGapDays Int?
  createdAt    DateTime            @default(now())

  @@index([experimentId, mode, foldIndex])
  @@index([runId])
  @@index([createdAt])
}

model FeatureResearch {
  id           String                @id @default(cuid())
  experimentId String?
  experiment   ResearchExperiment?   @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  featureKey   String
  category     String?
  sampleSize   Int                   @default(0)
  importance   Float?
  winRate      Float?
  avgReturn    Float?
  correlation  Float?
  rank         Int?
  status       FeatureResearchStatus @default(ACTIVE)
  metrics      Json?
  createdAt    DateTime              @default(now())

  @@index([experimentId, rank])
  @@index([featureKey, status])
  @@index([createdAt])
}

model StrategyResearch {
  id                String              @id @default(cuid())
  experimentId      String?
  experiment        ResearchExperiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  genomeId          String?
  strategyType      StrategyArchetype
  strategyVersion   String
  benchmarkScore    Float?
  metrics           Json?
  rank              Int?
  passedValidation  Boolean             @default(false)
  createdAt         DateTime            @default(now())

  @@index([experimentId, rank])
  @@index([genomeId])
  @@index([strategyType, createdAt])
}

model ExperimentMetrics {
  id             String             @id @default(cuid())
  experimentId   String
  experiment     ResearchExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  profitFactor   Float?
  expectancy     Float?
  sharpe         Float?
  sortino        Float?
  winRate        Float?
  avgProfit      Float?
  avgLoss        Float?
  maxDrawdownPct Float?
  avgHoldSec     Float?
  tradeCount     Int                @default(0)
  metrics        Json?
  createdAt      DateTime           @default(now())

  @@index([experimentId, createdAt])
}

model ResearchRecommendation {
  id                  String                   @id @default(cuid())
  experimentId        String?
  experiment          ResearchExperiment?      @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  recommendationType  ResearchRecommendationType
  title               String
  summary             String?
  expectedImprovement Float?
  confidence          Float?
  evidence            Json?
  status              String                   @default("PENDING")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([experimentId, status])
  @@index([recommendationType, createdAt])
}

enum PaperValidationJobType {
  SYNC_PORTFOLIO
  RECORD_TRADES
  CALCULATE_METRICS
  COIN_RANKING
  SESSION_ANALYSIS
  MISSED_OPPORTUNITY
  ACCURACY_CHECK
  RISK_VALIDATION
  READINESS_SCORE
  DAILY_REPORT
}

enum PaperTradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum PaperTradeSide {
  BUY
  SELL
}

enum LiveReadinessStatus {
  NOT_READY
  APPROACHING
  READY
  RECOMMENDED
}

enum MissedOpportunityCategory {
  REJECTED
  IGNORED
  LATE_ENTRY
  EARLY_EXIT
  LATE_EXIT
  FALSE_POSITIVE
  FALSE_NEGATIVE
}

model PaperPortfolio {
  id               String   @id @default(cuid())
  userId           String   @unique
  balance          Float    @default(0)
  availableBalance Float    @default(0)
  lockedBalance    Float    @default(0)
  totalPnl         Float    @default(0)
  totalFees        Float    @default(0)
  totalSlippage    Float    @default(0)
  unrealizedPnl    Float    @default(0)
  positionCount    Int      @default(0)
  metadata         Json?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  trades PaperTrade[]

  @@index([updatedAt])
}

model PaperTrade {
  id                String           @id @default(cuid())
  tradeKey          String           @unique
  userId            String
  portfolioId       String?
  portfolio         PaperPortfolio?  @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  symbol            String
  side              PaperTradeSide
  status            PaperTradeStatus @default(OPEN)
  strategy          String?
  marketRegime      String?
  entryPrice        Float
  exitPrice         Float?
  quantity          Float
  avgEntryPrice     Float?
  realizedPnl       Float            @default(0)
  returnPct         Float            @default(0)
  fees              Float            @default(0)
  slippagePct       Float            @default(0)
  holdSec           Int?
  decisionId        String?
  executionId       String?
  positionId        String?
  simulationId      String?
  tradeQualityScore Float?
  entryScore        Float?
  exitScore         Float?
  executionScore    Float?
  decisionScore     Float?
  riskScore         Float?
  overallScore      Float?
  openedAt          DateTime         @default(now())
  closedAt          DateTime?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  executions PaperExecution[]
  metrics    PaperMetrics?

  @@index([userId, status, openedAt])
  @@index([symbol, openedAt])
  @@index([decisionId])
  @@index([positionId])
}

model PaperExecution {
  id                  String     @id @default(cuid())
  executionKey        String     @unique
  paperTradeId        String
  paperTrade          PaperTrade @relation(fields: [paperTradeId], references: [id], onDelete: Cascade)
  simulationId        String?
  executionId         String?
  side                String
  requestedQty        Float?
  executedQty         Float
  requestedPrice      Float?
  avgFillPrice        Float
  spreadPct           Float?
  slippagePct         Float?
  fee                 Float      @default(0)
  latencyMs           Int?
  fillCount           Int        @default(1)
  bidPrice            Float?
  askPrice            Float?
  depthUsed           Float?
  expectedFillPrice   Float?
  fillAccuracyPct     Float?
  priceDifference     Float?
  latencyDifferenceMs Int?
  metadata            Json?
  executedAt          DateTime   @default(now())

  @@index([paperTradeId, executedAt])
  @@index([simulationId])
  @@index([executionId])
}

model PaperMetrics {
  id             String     @id @default(cuid())
  paperTradeId   String     @unique
  paperTrade     PaperTrade @relation(fields: [paperTradeId], references: [id], onDelete: Cascade)
  userId         String
  profitFactor   Float?
  expectancy     Float?
  winRate        Float?
  maxDrawdownPct Float?
  avgHoldSec     Float?
  metrics        Json?
  computedAt     DateTime   @default(now())

  @@index([userId, computedAt])
}

model DailyPaperReport {
  id             String   @id @default(cuid())
  userId         String
  reportDate     DateTime @db.Date
  tradeCount     Int      @default(0)
  winRate        Float?
  profitFactor   Float?
  expectancy     Float?
  maxDrawdownPct Float?
  avgHoldSec     Float?
  avgProfit      Float?
  avgLoss        Float?
  totalFees      Float?
  totalSlippage  Float?
  bestCoin       String?
  worstCoin      String?
  bestStrategy   String?
  worstStrategy  String?
  bestRegime     String?
  worstRegime    String?
  content        Json?
  summary        String?
  createdAt      DateTime @default(now())

  @@unique([userId, reportDate])
  @@index([reportDate])
}

model CoinPerformance {
  id             String    @id @default(cuid())
  userId         String
  symbol         String
  tradeCount     Int       @default(0)
  winRate        Float?
  avgReturn      Float?
  avgHoldSec     Float?
  profitFactor   Float?
  maxDrawdownPct Float?
  avgSlippage    Float?
  periodStart    DateTime?
  periodEnd      DateTime?
  metadata       Json?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@unique([userId, symbol])
  @@index([userId, winRate])
}

model SessionPerformance {
  id           String   @id @default(cuid())
  userId       String
  sessionType  String
  marketRegime String?
  tradeCount   Int      @default(0)
  winRate      Float?
  avgReturn    Float?
  profitFactor Float?
  metadata     Json?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([userId, sessionType, marketRegime])
  @@index([userId, sessionType])
}

model LiveReadiness {
  id                  String              @id @default(cuid())
  userId              String
  reportDate          DateTime            @db.Date
  readinessScore      Float               @default(0)
  status              LiveReadinessStatus @default(NOT_READY)
  minTradesMet        Boolean             @default(false)
  minProfitFactorMet  Boolean             @default(false)
  minWinRateMet       Boolean             @default(false)
  maxDrawdownMet      Boolean             @default(false)
  dataQualityMet      Boolean             @default(false)
  executionQualityMet Boolean             @default(false)
  replayIntegrityMet  Boolean             @default(false)
  recommendation      String?
  expectedImprovement Float?
  confidence          Float?
  evidence            Json?
  blockers            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([userId, reportDate])
  @@index([readinessScore, reportDate])
}

model PaperMissedOpportunity {
  id                 String                    @id @default(cuid())
  userId             String
  decisionId         String?
  symbol             String
  category           MissedOpportunityCategory
  baselineReturnPct  Float?
  potentialReturnPct Float?
  evidence           Json?
  createdAt          DateTime                  @default(now())

  @@index([userId, category, createdAt])
  @@index([decisionId])
}

model PaperValidationJobState {
  id              String                 @id @default(cuid())
  jobType         PaperValidationJobType @unique
  lastProcessedAt DateTime?
  status          String                 @default("IDLE")
  metadata        Json?
  updatedAt       DateTime               @updatedAt
  createdAt       DateTime               @default(now())
}

enum LiveTradingJobType {
  HEALTH_MONITOR
  POSITION_RECOVERY
  RECONCILIATION
  EXECUTION_AUDIT
  ALERT_DISPATCH
  CIRCUIT_BREAKER_CHECK
  KILL_SWITCH_MONITOR
  PRODUCTION_REPORT
  GO_LIVE_VALIDATE
}

enum LiveTradeStatus {
  OPEN
  CLOSED
  CANCELLED
  RECOVERED
}

enum CircuitBreakerReason {
  EXCHANGE_UNAVAILABLE
  DATABASE_UNAVAILABLE
  RISK_ENGINE_FAILURE
  DECISION_ENGINE_FAILURE
  FEATURE_SNAPSHOT_FAILURE
  REPLAY_FAILURE
  MODEL_UNAVAILABLE
  PREDICTION_CONFIDENCE_UNAVAILABLE
  EXECUTION_FAILURE_THRESHOLD
  BALANCE_MISMATCH
  PORTFOLIO_MISMATCH
  MANUAL
}

enum KillSwitchSource {
  MANUAL
  AUTOMATIC
  API
  DASHBOARD
  TELEGRAM
  CIRCUIT_BREAKER
}

enum LiveAlertChannel {
  TELEGRAM
  DISCORD
  SLACK
  WEBHOOK
  EMAIL
}

enum LiveAlertSeverity {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum ProductionReportCadence {
  DAILY
  WEEKLY
  MONTHLY
}

model LiveTrade {
  id              String          @id @default(cuid())
  tradeKey        String          @unique
  userId          String
  symbol          String
  side            String
  status          LiveTradeStatus @default(OPEN)
  strategy        String?
  marketRegime    String?
  entryPrice      Float
  exitPrice       Float?
  quantity        Float
  realizedPnl     Float           @default(0)
  returnPct       Float           @default(0)
  fees            Float           @default(0)
  slippagePct     Float           @default(0)
  holdSec         Int?
  decisionId      String?
  executionId     String?
  positionId      String?
  modelVersion    String?
  openedAt        DateTime        @default(now())
  closedAt        DateTime?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  executions LiveExecution[]

  @@index([userId, status, openedAt])
  @@index([symbol, openedAt])
  @@index([executionId])
  @@index([positionId])
}

model LiveExecution {
  id                  String    @id @default(cuid())
  executionKey        String    @unique
  liveTradeId         String?
  liveTrade           LiveTrade? @relation(fields: [liveTradeId], references: [id], onDelete: SetNull)
  userId              String
  executionId         String?
  logKey              String?
  symbol              String
  side                String
  orderRequest        Json?
  exchangeResponse    Json?
  requestedQty        Float?
  executedQty         Float
  requestedPrice      Float?
  fillPrice           Float
  commission          Float     @default(0)
  slippagePct         Float     @default(0)
  latencyMs           Int?
  executionConfidence Float?
  executionResult     String    @default("FILLED")
  metadata            Json?
  executedAt          DateTime  @default(now())

  audit LiveExecutionAudit?

  @@index([userId, executedAt])
  @@index([executionId])
  @@index([symbol, executedAt])
}

model LiveExecutionAudit {
  id               String        @id @default(cuid())
  liveExecutionId  String        @unique
  liveExecution    LiveExecution @relation(fields: [liveExecutionId], references: [id], onDelete: Cascade)
  orderRequest     Json?
  exchangeResponse Json?
  latencyMs        Int?
  fillPrice        Float?
  commission       Float?
  slippagePct      Float?
  executionResult  String?
  executionConfidence Float?
  metadata         Json?
  auditedAt        DateTime      @default(now())

  @@index([auditedAt])
}

model CircuitBreakerEvent {
  id          String               @id @default(cuid())
  userId      String?
  reason      CircuitBreakerReason
  active      Boolean              @default(true)
  message     String?
  evidence    Json?
  triggeredAt DateTime             @default(now())
  resolvedAt  DateTime?
  metadata    Json?

  @@index([active, triggeredAt])
  @@index([userId, reason])
}

model KillSwitchEvent {
  id          String           @id @default(cuid())
  userId      String?
  source      KillSwitchSource
  active      Boolean          @default(true)
  reason      String
  triggeredBy String?
  evidence    Json?
  triggeredAt DateTime         @default(now())
  releasedAt  DateTime?
  metadata    Json?

  @@index([active, triggeredAt])
  @@index([userId, source])
}

model ProductionHealth {
  id                  String   @id @default(cuid())
  userId              String?
  exchangeLatencyMs   Float?
  restLatencyMs       Float?
  wsLatencyMs         Float?
  predictionLatencyMs Float?
  executionLatencyMs  Float?
  queueHealthy        Boolean  @default(true)
  databaseHealthy     Boolean  @default(true)
  workersHealthy      Boolean  @default(true)
  exchangeHealthy     Boolean  @default(true)
  timeSyncHealthy     Boolean  @default(true)
  overallScore        Float    @default(0)
  metadata            Json?
  recordedAt          DateTime @default(now())

  @@index([recordedAt])
  @@index([userId, recordedAt])
}

model CapitalProtection {
  id                    String   @id @default(cuid())
  userId                String   @unique
  dailyPnl              Float    @default(0)
  dailyTradeCount       Int      @default(0)
  consecutiveLosses     Int      @default(0)
  openPositionCount     Int      @default(0)
  totalExposure         Float    @default(0)
  maxCoinExposure       Float    @default(0)
  dailyLossLimitPct     Float    @default(5)
  maxDailyTrades        Int      @default(50)
  maxOpenPositions      Int      @default(5)
  maxPositionSizePct    Float    @default(10)
  maxExposurePct        Float    @default(50)
  maxCoinExposurePct    Float    @default(15)
  maxConsecutiveLosses  Int      @default(5)
  blocked               Boolean  @default(false)
  blockReason           String?
  metadata              Json?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@index([blocked, updatedAt])
}

model LiveAlert {
  id          String            @id @default(cuid())
  userId      String?
  channel     LiveAlertChannel
  severity    LiveAlertSeverity @default(INFO)
  eventType   String
  title       String
  message     String
  delivered   Boolean           @default(false)
  deliveredAt DateTime?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([eventType, severity])
  @@index([delivered, createdAt])
}

model ProductionReport {
  id          String                  @id @default(cuid())
  userId      String
  cadence     ProductionReportCadence
  reportDate  DateTime                @db.Date
  tradeCount  Int                     @default(0)
  winRate     Float?
  profitFactor Float?
  expectancy  Float?
  dailyPnl    Float?
  weeklyPnl   Float?
  monthlyPnl  Float?
  maxDrawdown Float?
  content     Json?
  summary     String?
  createdAt   DateTime                @default(now())

  @@unique([userId, cadence, reportDate])
  @@index([reportDate])
}

model LiveTradingJobState {
  id              String             @id @default(cuid())
  jobType         LiveTradingJobType @unique
  lastProcessedAt DateTime?
  status          String             @default("IDLE")
  metadata        Json?
  updatedAt       DateTime           @updatedAt
  createdAt       DateTime           @default(now())
}
